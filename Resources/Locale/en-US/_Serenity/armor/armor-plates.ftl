serenity-armor-plate-carrier-empty = It has room for an armor plate, but none is fitted.
serenity-armor-plate-carrier-plate = It has a [color=yellow]{ $plate }[/color] fitted.
serenity-armor-plate-carrier-plate-durability = It has a [color=yellow]{ $plate }[/color] fitted, at [color={ $color }]{ $percent }%[/color] integrity.
serenity-armor-plate-durability = Integrity: [color={ $color }]{ $percent }%[/color]
serenity-armor-plate-broke = Your { $plate } breaks apart!

serenity-armor-plate-verb-text = Plate stats
serenity-armor-plate-verb-message = See what this plate protects against and what it costs you.
serenity-armor-plate-stats-header = When fitted into armor, this plate:
serenity-armor-plate-stats-durability = - can take [color=yellow]{ $durability }[/color] damage before it breaks.
serenity-armor-plate-stats-absorbs = - stops [color=yellow]{ $percent }%[/color] of [color=cyan]{ $type }[/color] damage.
serenity-armor-plate-stats-amplifies = - lets through [color=yellow]{ $percent }%[/color] more [color=fuchsia]{ $type }[/color] damage.
serenity-armor-plate-stats-walk = - makes you walk [color=yellow]{ $percent }%[/color] { $change ->
        [faster] faster
       *[slower] slower
    }.
serenity-armor-plate-stats-sprint = - makes you run [color=yellow]{ $percent }%[/color] { $change ->
        [faster] faster
       *[slower] slower
    }.
serenity-armor-plate-stats-stamina-absorbed = - drains stamina equal to [color=yellow]{ $percent }%[/color] of the damage it stops.
serenity-armor-plate-stats-stamina-amplified = - drains stamina equal to [color=yellow]{ $percent }%[/color] of the extra damage it lets through.
serenity-armor-plate-stats-stamina-hit = - drains stamina equal to [color=yellow]{ $percent }%[/color] of every hit you take.
