station-event-sector-generic-start = Long-range sensors report a bluespace anomaly depositing something near the outpost.
station-event-sector-generic-end = The bluespace anomaly has collapsed. Anything left behind has been recalled.

station-event-sector-cache-start = Sensors have located a Syndicate weapons cache that slipped through a bluespace tear near the outpost. Expect it to be guarded.
station-event-sector-cache-end = The bluespace tear holding the Syndicate cache has closed.

station-event-sector-vault-start = A sealed corporate vault has been displaced by a bluespace error and is drifting near the outpost.
station-event-sector-vault-end = The displaced vault has returned to bluespace.

station-event-sector-vessel-start = An unidentified vessel has dropped out of FTL near the outpost. Its IFF is not responding.
station-event-sector-vessel-end = The unidentified vessel has jumped away.

station-event-sector-name-cache = Syndicate Weapons Cache
station-event-sector-name-vault = Secure Vault
station-event-sector-name-vessel = Unidentified Vessel
