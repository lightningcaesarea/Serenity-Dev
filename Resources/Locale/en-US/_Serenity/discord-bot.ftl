## Discord bot status

serenity-discord-status = {$players} · {$round}
serenity-discord-status-players = {$count ->
    [one] 1 player
   *[other] {$count} players
}
serenity-discord-status-round = Round {$time}
serenity-discord-status-round-over = Round over
serenity-discord-status-lobby = In lobby

## Ahelp replies from Discord

serenity-ahelp-discord-name = {$name} (Discord)
